# 复制本文件为 .env，填好下面三个 key 就能用：
#   S2S_DOUBAO_API_KEY    火山引擎「豆包语音」，给「豆包」链路
#   LLM_DEEPSEEK_API_KEY  DeepSeek，给「大肥鱼」链路的想
#   ASR_VOLCANO_API_KEY   火山一句话识别，给「大肥鱼」链路的听（与豆包同一控制台）
#
# 其余参数（音色、音量、唤醒、设备、白名单…）都在 config/defaults.env，
# 已按实测调好并随代码入库，不用复制、不用改。
# 需要覆盖其中任意一项时，在本文件按同样 KEY=VALUE 写一行即可；
# 真实环境变量优先级更高。留空等于覆盖成空值，所以不用的项请注释掉。

S2S_DOUBAO_API_KEY=
LLM_DEEPSEEK_API_KEY=
ASR_VOLCANO_API_KEY=


# -- 以下都是可选覆盖，一般不用动 --

# 多数 USB 声卡需要显式写设备（default 打不开采集）；
# 设备名用 bash preflight/audio-check.sh 的报告，或 arecord -l / aplay -l 查
# AUDIO_IN_DEVICE=plughw:3,0
# AUDIO_OUT_DEVICE=plughw:3,0

# 想换豆包音色（默认 zh_female_vv_jupiter_bigtts，见火山控制台音色列表）
# S2S_DOUBAO_VOICE=zh_female_vv_jupiter_bigtts

# 后台能力（阶段 5，当前无实现）
# SEARCH_API_KEY=
# WXPUSHER_TOKEN=
# WXPUSHER_UID=
