# 仓库内默认配置：随代码版本化，已按实测调好，用户一般不用改
# 覆盖顺序：本文件 < .env < 真实环境变量
# 这里不出现任何凭据；凭据只写在 .env（模板见 .env.example）

# -- 音频与会话 --
# default 在多数 USB 声卡上打不开采集，需要在 .env 覆盖成 plughw:<card>,<device>
# 设备名用 bash preflight/audio-check.sh 的报告，或 arecord -l / aplay -l 查
AUDIO_IN_DEVICE=default
AUDIO_OUT_DEVICE=default
# 播放端总音量 0~200，100 为原始；豆包响度由服务端负责，这里保持 100
AUDIO_OUT_VOLUME=100
# 唤醒后播提示音（1 开 0 关）
WAKE_CHIME=1
# 最后一条活动之后多少秒无活动即结束（秒），两条链路同一口径：
#   活动只有两种 —— 用户开口、模型还在输出（S2S 任何下行事件；三段式播报中）
#   等起音、识别往返、重试、工具执行都不续时，只消耗剩余额度
SILENCE_TIMEOUT_SEC=10
# 说话判定阈值（RMS）：底噪约 200~300，人声 600+；调高可避免把噪声当说话
AUDIO_IN_SILENCE_RMS=900
# 采样率与帧长由协议固定：上行 16 kHz / 下行 24 kHz / 20 ms 帧，不提供配置项

# -- 打断（S2S）--
# 播报中检测到人声起音就立刻停播并取消服务端这一轮回答（1 开 0 关）
S2S_BARGE_IN=1
# 打断阈值（RMS）：高于 AUDIO_IN_SILENCE_RMS，避开扬声器回采；误打断就往上调
S2S_BARGE_IN_RMS=1200
# 打断词：短句命中就整轮不播报——「停」是一句指令，不是提问，服务端那句回话要丢掉
S2S_STOP_WORDS=停,停下,停止,别说了,不要说了,闭嘴,打住

# -- 唤醒词（离线，待机期零云端连接）--
# kws=关键词检测（CPU 最低，默认）；vosk=离线 ASR（备选）
WAKEWORD_ENGINE=kws
WAKEWORD_KWS_DIR=data/models/kws
WAKEWORD_KWS_KEYWORDS=data/models/kws/keywords.txt
WAKEWORD_KWS_SCORE=1.0
WAKEWORD_KWS_THRESHOLD=0.25
WAKEWORD_KWS_THREADS=2
WAKEWORD_MODEL_PATH=data/models/wakeword

# -- 三段式的听与说 --
# 听：火山一句话识别（麦克风整句），需要 ASR_VOLCANO_API_KEY
# 说：edge-tts（免费、无需凭据）
ASR_PROVIDER=volcano
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
# 一句说完后的静音判停（毫秒）；太短会把句子切碎，太长则反应慢
ASR_SILENCE_MS=1200
# 单句最长录多久（秒），超时强制送出，避免一口气说太久
ASR_MAX_UTTERANCE_SEC=15
# 唤醒后是否先说一句：留空（默认）不播，响应最快，靠唤醒提示音反馈
# 想要语音回应可填短句（如「在的，你说」），代价是多一次合成、约 0.5~1 秒
LLM_GREETING=
LLM_SYSTEM_PROMPT=你是一个简洁的私人语音助手，用口语、短句回答。

# -- S2S_DOUBAO（豆包 Seeduplex；音色与音量已调好）--
S2S_DOUBAO_MODEL=1.2.6.1
S2S_DOUBAO_VOICE=zh_female_vv_jupiter_bigtts
S2S_DOUBAO_WS_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
# 唤醒后豆包先说的第一句话；想让它保持沉默就注释掉
S2S_DOUBAO_GREETING=我在，请说
# 服务端合成音量 0~200：100 为原始，200 为官方上限（2 倍）
S2S_DOUBAO_LOUDNESS=140
# 响度均衡（1 开 0 关）：压平句与句之间的忽大忽小
S2S_DOUBAO_LOUDNESS_NORM=1
# 段首补偿：前 70% 时间保持抬升，再线性回落；ONSET_EVERY=1 改逐段补
S2S_DOUBAO_ONSET_BOOST_DB=12
S2S_DOUBAO_ONSET_SEC=0.6
S2S_DOUBAO_ONSET_EVERY=0

# -- LLM_DEEPSEEK（OpenAI 兼容）--
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEEPSEEK_MODEL=deepseek-chat

# -- 出站白名单（零入站端口）--
# 按注册表内实际启用的服务补域名
OUTBOUND_ALLOWLIST=openspeech.bytedance.com,api.deepseek.com,speech.platform.bing.com
DATA_DIR=data
SCRIPTS_DIR=scripts
